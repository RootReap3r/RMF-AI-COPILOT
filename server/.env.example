# ─────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# Switch providers by changing these values only — no code changes.
# ─────────────────────────────────────────────────────────────────

# Which adapter to use:
#   "openai"     -> any OpenAI-compatible Chat Completions API
#                    (DeepSeek, vLLM, TGI, Ollama, most SIPR/NIPR
#                     internal LLM gateways, Azure OpenAI, etc.)
#   "anthropic"  -> native Anthropic Messages API format
#                    (api.anthropic.com OR an internal gateway that
#                     mirrors the Anthropic /v1/messages schema, e.g.
#                     some Bedrock proxies)
#   "bedrock"    -> AWS Bedrock Converse API (IAM auth — no LLM_API_KEY needed;
#                    LLM_BASE_URL is ignored; set AWS_REGION and LLM_MODEL below)
LLM_PROVIDER=openai

# Base URL for the API (no trailing slash)
#   DeepSeek:         https://api.deepseek.com
#   OpenAI:           https://api.openai.com/v1
#   Anthropic:        https://api.anthropic.com
#   SIPR/NIPR/FENCES: <your internal endpoint URL here>
#   Bedrock:          not used — omit or leave as-is
LLM_BASE_URL=https://api.deepseek.com

# Model name as expected by that provider
#   DeepSeek:    deepseek-chat
#   OpenAI:      gpt-4o
#   Anthropic:   claude-sonnet-4-20250514
#   Internal:    <whatever your environment calls it>
#   Bedrock:     anthropic.claude-sonnet-4-20250514-v1:0
#                amazon.nova-pro-v1:0
#                meta.llama3-70b-instruct-v1:0
LLM_MODEL=deepseek-chat

# API key / token for the above provider
# NOT required when LLM_PROVIDER=bedrock (auth uses the AWS credential chain instead)
LLM_API_KEY=sk-REPLACE_ME

# ─────────────────────────────────────────────────────────────────
# AWS BEDROCK CONFIGURATION (only when LLM_PROVIDER=bedrock)
# ─────────────────────────────────────────────────────────────────

# AWS region where your Bedrock models are enabled.
# Standard:  us-east-1  (most models available here)
# GovCloud:  us-gov-west-1  (limited model selection — check AWS console)
# AWS_REGION=us-east-1

# AWS credentials — leave unset when running on EC2/ECS/Lambda with an IAM role
# (the SDK picks up the role automatically). Supply explicitly for local dev or
# environments without instance metadata.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...  # only needed for temporary/assumed-role credentials

# ─────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────

# Port the backend listens on
PORT=3001

# Path to the local JSON storage file (persists tracker progress)
STORAGE_FILE=./data/storage.json

# ─────────────────────────────────────────────────────────────────
# SECURITY (authentication required)
# ─────────────────────────────────────────────────────────────────

# API access token. All /api requests (except /api/health)
# must include either:
#   X-Api-Key: <your-token>
#   Authorization: Bearer <your-token>
# Missing or weak tokens stop server startup.
# Required: generate with openssl rand -hex 32
AUTH_TOKEN=

# Allowed CORS origins (comma-separated). Defaults to local development origins; wildcard is rejected.
# Restrict this when the server is exposed beyond localhost.
# CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# LLM rate limiting (requests per window per IP)
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

